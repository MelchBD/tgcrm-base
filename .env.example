# Names only - never commit real values. These are set in the host's environment (we use Railway).

# --- Agent payments (x402) -------------------------------------------------
CDP_API_KEY_ID=            # Coinbase Developer Platform key (authenticates the server to the x402 facilitator)
CDP_API_KEY_SECRET=
X402_PAY_TO=0x...          # public address that RECEIVES agent payments (no private key is ever stored)
X402_ENV=development       # development = Base Sepolia (test USDC)  |  production = Base mainnet (real USDC)

# --- Pro lookup packs (Base Pay) -------------------------------------------
USDC_PAY_TO=0x...          # optional - falls back to X402_PAY_TO
USDC_NETWORK=base-sepolia  # base-sepolia | base

# --- Tuning (all optional) ---------------------------------------------------
TGF_LOOKUP_PRICE_USD=1.00  # price of one agent lookup
TGF_PACK_LOOKUPS=10
TGF_PACK_PRICE_USDC=10.00
X402_MAX_PER_HOUR=20       # spend guard on the shared TG Finder account
X402_MAX_PER_DAY=100

# --- Demo agent only (your own machine, NEVER the server) --------------------
# CDP_WALLET_SECRET=
